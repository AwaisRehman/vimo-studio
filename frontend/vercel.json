{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://vimo-api-awais.vercel.app/api/:path*" },
    { "source": "/docs", "destination": "https://vimo-api-awais.vercel.app/docs" },
    { "source": "/openapi.json", "destination": "https://vimo-api-awais.vercel.app/openapi.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
